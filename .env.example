# ============================================================
# GitHub-AI-Studio 环境变量模版
# 使用：copy .env.example .env 后填入真实凭证
# 注意：.env 已被 .gitignore 忽略，切勿提交！
# ============================================================

# ---------- GitHub ----------
# Personal Access Token；如果已用 `gh auth login` 登录，可留空（自动复用 gh 凭证）
GITHUB_TOKEN=

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 可选：兼容 OpenAI 的中转地址（OpenRouter / 硅基流动 / 智谱等）
OPENAI_BASE_URL=
# 可选：备用模型降级链（逗号分隔）——主模型限流/超时/网关错误时自动按顺序切换
# 例：OPENAI_FALLBACK_MODEL=gpt-4o-mini,deepseek-chat
OPENAI_FALLBACK_MODEL=
# 可选：按场景覆盖模型（留空用 OPENAI_MODEL）
# COMMIT_MODEL=   提交信息生成；TRENDING_MODEL=   热榜筛选/翻译/研读/简报
COMMIT_MODEL=
TRENDING_MODEL=

# ---------- 个人偏好 ----------
USER_INTERESTS=AI Agent, Python, Rust, DevTools

# ---------- 仓库默认配置 ----------
DEFAULT_REPO_VISIBILITY=private
DEFAULT_BRANCH=main
REQUEST_TIMEOUT=30

# ---------- 每日热榜 ----------
TRENDING_SINCE=daily
TRENDING_FETCH_LIMIT=25
TRENDING_TOP_N=3

# ---------- 手机推送：Ntfy.sh（推荐，锁屏通知栏可直接操作） ----------
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=github-ai-studio
# 自建 Ntfy 服务需要鉴权时填写（可选）
NTFY_TOKEN=
# 归档 Notion 的 Webhook（可选）：通知栏点击即可触发归档
NTFY_ARCHIVE_WEBHOOK=

# ---------- 手机推送（可选渠道：钉钉 / 企业微信 / 邮件） ----------
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
WECHAT_WEBHOOK=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=
FEISHU_WEBHOOK=
FEISHU_SECRET=

# ---------- Notion 归档（可选） ----------
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ---------- 其他 ----------
AI_FALLBACK_ENABLED=true
# 每日自动推送（APScheduler 后台调度，界面可实时修改）
AUTO_PUSH_ENABLED=true
AUTO_PUSH_TIME=08:30
# 国内访问 GitHub 需要的代理（Clash 默认 7890）
HTTPS_PROXY=
HTTP_PROXY=
